---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (date: Date) =>
  date.toLocaleDateString('pt-BR', { year: 'numeric', month: 'short', day: '2-digit' });
---

<Layout title="Início">
  <section class="mb-14 border-b border-line pb-12 sm:mb-16">
    <blockquote class="border-l-2 border-accent-warm/50 pl-5 font-serif text-xl italic leading-[1.7] text-ink-strong sm:text-2xl">
      "There's some good in this world, Mr. Frodo, and it's worth fighting for."
      <footer class="mt-3 font-sans text-xs not-italic uppercase tracking-wide text-ink-faint">
        — Samwise Gamgee
      </footer>
    </blockquote>
  </section>

  <section>
    <h2 class="mb-6 font-sans text-xs font-semibold uppercase tracking-[0.2em] text-ink-faint">
      Últimos textos
    </h2>
    <ul class="divide-y divide-line">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="group flex flex-col gap-1 py-4 no-underline sm:flex-row sm:items-baseline sm:justify-between sm:gap-4"
            >
              <span class="font-serif text-lg text-ink-strong transition-colors group-hover:text-oak">
                {post.data.title}
              </span>
              <time
                datetime={post.data.date.toISOString()}
                class="shrink-0 font-sans text-xs uppercase tracking-wide text-ink-faint"
              >
                {formatDate(post.data.date)}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
